# =============================================
# Python AI Microservice — Mekong WebGIS
# =============================================

# Groq API Keys (xoay vòng để tránh rate limit)
GROQ_KEY_1=your-groq-key-1
GROQ_KEY_2=your-groq-key-2
GROQ_KEY_3=your-groq-key-3

# Model
GROQ_MODEL=qwen/qwen3-7b-it

# Java Backend
JAVA_API_URL=http://localhost:8084

# S3 Config (kế thừa từ backend)
S3_ENDPOINT=https://backup.hci.vn
S3_BUCKET=c01-mekong-prod-01
S3_ACCESS_KEY=dummy-access-key
S3_SECRET_KEY=dummy-secret-key
S3_REGION=us-east-1

# Service Config
AI_SERVICE_PORT=8090
AI_SERVICE_HOST=0.0.0.0

# LangChain Memory
MEMORY_WINDOW_SIZE=10
